# Sanity (next-sanity convention — no aliases)
NEXT_PUBLIC_SANITY_PROJECT_ID="qwwmf79r"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2026-01-01"

# Server-only, viewDrafts scope
SANITY_API_READ_TOKEN="<paste your Sanity read token here>"

# Server-only, with write access. Writes map projects. Outside Netlify's production deploy, the
# website refuses to write to the production dataset, so local runs use "development".
SANITY_API_WRITE_TOKEN="<paste your Sanity write token here>"

# Server-only. BlueIQ sends this key with each plant file. Use at least 32 random bytes,
# such as the output of `openssl rand -base64 32`. The real key lives only in Netlify.
BLUEIQ_FEED_KEY="<paste a local test key here>"

# Studio URL — used by stega.studioUrl for click-to-edit deep links
NEXT_PUBLIC_SANITY_STUDIO_URL="http://localhost:3333"

# Frontend origin — used by Presentation Tool config + defineEnableDraftMode
NEXT_PUBLIC_SITE_URL="https://bluepathfinance.com"

# Analytics needs no variable. The Google Tag Manager container ID is in app/layout.tsx,
# and it loads only on Netlify's production deploy (CONTEXT=production).

# Google Maps (client-side)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="<paste your Google Maps browser key here>"
